# Скопируй в .env и заполни. Файл .env в репозиторий не попадает.

# Хеш пароля режима редактора. Получить:  .venv/bin/python -m server.hash_password
ADMIN_PASSWORD_HASH=

# Случайная строка для подписи сессий. Получить:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# true на сервере с HTTPS (cookie уходит только по https), false для локальной разработки
COOKIE_SECURE=false

# Бот от @BotFather и твой chat_id — сюда приходят сообщения из формы
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Если сервер не достаёт до api.telegram.org по адресу из DNS — IP Telegram, которые пробовать первыми
TELEGRAM_API_IPS=
